# LegalLens Common Environment Variables

# Google Cloud Platform & Vertex AI
GOOGLE_CLOUD_PROJECT=<GCP-PROJECT>
GOOGLE_CLOUD_LOCATION=<REGIN>
GOOGLE_GENAI_USE_ENTERPRISE=1
GCS_BUCKET_NAME=<GCP-BUCKET-NAME>

# Database Type: 'firestore' (production) or 'sqlite' (local / testing)
DATABASE_TYPE=firestore
SQLITE_DB_URL=sqlite+aiosqlite:////app/data/<DB_NAME>.db
DEFAULT_USER_ID=legal_user_default

# ADK Server URL (within Docker network: http://agent:8000; in k8s: http://legallens-agent:8000)
ADK_SERVER_URL=http://agent:8000
ADK_APP_NAME=legallens

# Path to Google Application Default Credentials file on your host machine
# Defaults to standard macOS path: ~/.config/gcloud/application_default_credentials.json
# On Linux: ~/.config/gcloud/application_default_credentials.json
# Or provide a dedicated service-account-key.json
GCP_CREDENTIALS_PATH=~/.config/gcloud/application_default_credentials.json

# Port Mappings
FRONTEND_PORT=3000
BACKEND_PORT=8080
AGENT_PORT=8000
