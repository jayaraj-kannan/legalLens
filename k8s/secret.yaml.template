# Template for GCP credentials secret
# Option A (Recommended): Create directly via kubectl command:
#   kubectl create secret generic gcp-credentials \
#     --namespace legallens \
#     --from-file=key.json="${HOME}/.config/gcloud/application_default_credentials.json"
#
# Option B: Encode your key.json in base64:
#   cat key.json | base64
#   And paste the output below into data['key.json'], then apply this file.
apiVersion: v1
kind: Secret
metadata:
  name: gcp-credentials
  namespace: legallens
type: Opaque
stringData:
  # In development/local testing, if no key is provided, an empty fallback file will be mounted.
  # Replace with actual service account json for production.
  key.json: |
    {
      "type": "authorized_user",
      "client_id": "placeholder",
      "client_secret": "placeholder",
      "refresh_token": "placeholder"
    }
